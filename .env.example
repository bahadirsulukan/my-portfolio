# Contact form — copy this file to .env.local and fill in the values.
# .env.local is git-ignored; never commit the real key.

# From https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact form submissions are delivered
CONTACT_TO=bahadirsulukan@gmail.com

# Sender address. Until a domain is verified in Resend, leave this as the
# shared test sender below — it only delivers to the address the Resend
# account was registered with, which is fine for testing.
# Once bahadirsulukan.com is verified, switch to something like:
#   CONTACT_FROM=Portfolio <kontakt@bahadirsulukan.com>
CONTACT_FROM=Portfolio <onboarding@resend.dev>
